engine biome(1.0)
language js(typescript, jsx)

JsModuleSource() as $source where {
  $source <: within or {
    JsImport(),
    JsExport()
  },
  $source <: r"^[\"'](.*)\.ts[\"']$"($path),
  $source => `"$path"`,
  register_diagnostic(span=$source, message="Remove the .ts extension. Use moduleResolution: bundler in tsconfig.json to resolve imports without file extensions.", severity="error", fix_kind="unsafe")
}
