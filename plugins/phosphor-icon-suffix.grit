engine biome(1.0)
language js(jsx)

or {
  JsShorthandNamedImportSpecifier() as $spec,
  JsNamedImportSpecifier() as $spec
} where {
  $spec <: within `import { $_ } from "@phosphor-icons/react"`,
  $spec <: not r"^(?:type\s+)?(?:\w*Icon|Icon\w*)\b.*",
  register_diagnostic(span=$spec, message="Phosphor icon imports require Icon suffix", severity="error")
}
