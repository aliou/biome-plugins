engine biome(1.0)
language css

pattern positive_px() { r".*[1-9][0-9]*px.*" }

or {
  `$sel { $props }` where {
    $props <: contains `border-left: $val;` as $decl,
    $val <: r".*solid.*",
    not $sel <: r".*blockquote.*",
    not $props <: contains `border-top: $_;`,
    not $props <: contains `border-bottom: $_;`,
    not $props <: contains `border-right: $_;`,
    register_diagnostic(span=$decl, message="`border-left` on a non-blockquote box reads as an ad-hoc accent stripe, not a deliberate design. Use a full `border`, a `background` tint, or a top rule.", severity="warn")
  },
  `$sel { $props }` where {
    $props <: contains `border-left-width: $w;` as $decl,
    $w <: positive_px(),
    $props <: contains `border: $_;`,
    register_diagnostic(span=$decl, message="Overriding `border-left-width` to thicken one side of a full `border` is an ad-hoc accent. Use the same width on all sides, or a `background` tint.", severity="warn")
  }
}
