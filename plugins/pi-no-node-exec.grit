engine biome(1.0)
language js(typescript, jsx)

or {
  or {
    JsShorthandNamedImportSpecifier() as $node,
    JsNamedImportSpecifier() as $node
  } where {
    $node <: within or {
      `import { $_ } from "child_process"`,
      `import { $_ } from "node:child_process"`
    },
    $node <: r"^(?:execFileSync|execFile|execSync|exec|spawnSync|spawn|fork)\b.*"
  },
  `require("child_process")` as $node,
  `require("node:child_process")` as $node
} where {
  register_diagnostic(span=$node, message="Do not use child_process directly for spawning APIs. Use pi.exec() from the ExtensionAPI instead.", severity="error")
}
