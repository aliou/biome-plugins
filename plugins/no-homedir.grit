engine biome(1.0)
language js(typescript, jsx)

or {
  or {
    JsShorthandNamedImportSpecifier() as $node,
    JsNamedImportSpecifier() as $node
  } where {
    $node <: within or {
      `import { $_ } from "os"`,
      `import { $_ } from "node:os"`
    },
    $node <: r"^(?:homedir|userInfo)\b.*",
    register_diagnostic(span=$node, message="Do not use os.homedir() or os.userInfo(). Use a configured paths utility instead.", severity="error")
  },
  or {
    `process.env.HOME` as $node,
    `process.env["HOME"]` as $node
  } where {
    register_diagnostic(span=$node, message="Do not read process.env.HOME directly. Use a configured paths utility instead.", severity="error")
  }
}
