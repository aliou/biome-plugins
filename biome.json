{
	"$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
	"plugins": [
		"plugins/no-inline-imports.grit",
		"plugins/no-interpolated-classname.grit",
		"plugins/phosphor-icon-suffix.grit",
		"plugins/no-js-import-extension.grit",
		"plugins/no-ts-import-extension.grit",
		"plugins/no-emojis.grit",
		"plugins/no-inner-types.grit",
		"plugins/pi-no-node-exec.grit",
		"plugins/no-buried-await.grit",
		"plugins/no-empty-catch.grit",
		"plugins/no-homedir.grit",
		"plugins/no-is-record.grit",
		"plugins/no-unimported-text.grit",
		"plugins/no-chained-type-assertions.grit",
		"plugins/no-conditional-empty-object-spread.grit",
		"plugins/no-reflect-apply.grit",
		"plugins/no-reflect-get.grit",
		"plugins/no-runtime-typeof.grit",
		"plugins/no-unknown-parameters.grit",
		"plugins/no-unknown-returns.grit",
		"plugins/no-unsafe-dictionary-type.grit"
	],
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none"
		}
	}
}
